<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fonsica.dashboard-deploy</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/node</string>
        <string>/Users/adamfonsica/Projects/fonsica-website/_pipeline/stake-engine/deploy.mjs</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/adamfonsica/Projects/fonsica-website/_pipeline/stake-engine</string>

    <!-- Run daily at 09:00 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Log output -->
    <key>StandardOutPath</key>
    <string>/Users/adamfonsica/Projects/fonsica-website/_pipeline/logs/dashboard-deploy.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/adamfonsica/Projects/fonsica-website/_pipeline/logs/dashboard-deploy-error.log</string>
</dict>
</plist>
