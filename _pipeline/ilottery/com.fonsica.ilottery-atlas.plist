<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fonsica.ilottery-atlas</string>

    <!-- Rebuild, check and publish the iLottery Atlas (see update_atlas.py) -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/adamfonsica/Projects/fonsica-website/_pipeline/ilottery/update_atlas.py</string>
        <string>--publish</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/adamfonsica/Projects/fonsica-website</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>FONSICA_DATA</key>
        <string>/Users/adamfonsica/Projects/fonsica-insights/data</string>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Every hour and at login: fetch what the bot pushed to GitHub, then rebuild.
         Unchanged data exits in a few seconds. No WatchPaths: deliveries arrive through
         the job's own git pull, and watching the copy made each pull start the next run. -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>ThrottleInterval</key>
    <integer>120</integer>

    <key>StandardOutPath</key>
    <string>/Users/adamfonsica/Projects/fonsica-website/_pipeline/logs/ilottery-update.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/adamfonsica/Projects/fonsica-website/_pipeline/logs/ilottery-update.log</string>
</dict>
</plist>
